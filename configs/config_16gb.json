{
  "_comment": "RTX5080 (16GB) optimized configuration",

  "model": {
    "in_channels": 3,
    "out_channels": 3,
    "num_timesteps": 1000,
    "base_channels": 64,
    "time_emb_dim": 256,
    "num_res_blocks": 2,
    "attention_resolutions": [16, 8],
    "channel_multiples": [1, 2, 4, 8]
  },

  "dataset": {
    "data_dir": "data",
    "scenes": [
      "97_RZ_3586578_Aug-24-09-59-20"
    ],
    "num_frames": 32,
    "image_size": [160, 210],
    "seed": 42
  },

  "dataloader": {
    "batch_size": 12,
    "shuffle": true,
    "num_workers": 4,
    "pin_memory": true,
    "drop_last": false,
    "persistent_workers": true
  },

  "optimizer": {
    "type": "AdamW",
    "lr": 1e-4,
    "betas": [0.9, 0.999],
    "weight_decay": 0.01,
    "eps": 1e-8
  },

  "training": {
    "epochs": 10,
    "gradient_accumulation_steps": 1,
    "max_grad_norm": 1.0,
    "mixed_precision": {
      "enabled": true,
      "dtype": "float16"
    },
    "checkpoint": {
      "save_every_n_epochs": 5,
      "save_dir": "checkpoints",
      "keep_last_n": 3
    },
    "logging": {
      "log_every_n_steps": 10,
      "log_gpu_memory": true
    }
  },

  "hardware": {
    "device": "cuda",
    "allow_tf32": true
  },

  "wandb": {
    "enabled": true,
    "project": "video-diffusion-16gb",
    "entity": null,
    "run_name": null,
    "tags": ["16gb", "full-model"],
    "notes": "16GB VRAM configuration with full model",
    "watch_model": false,
    "sample_every_epoch": true,
    "num_sample_frames": 20,
    "sample_steps": 100
  },

  "performance_notes": {
    "gpu": "RTX5080 (16GB VRAM)",
    "estimated_vram": "~14-15 GB with mixed precision",
    "effective_batch_size": 12,
    "features": [
      "Full model: base_channels=64, 4 levels [1,2,4,8]",
      "32 frames per video sequence",
      "Mixed precision FP16 for memory efficiency",
      "AdamW optimizer with weight decay",
      "Batch size 12 optimized for 16GB VRAM"
    ]
  }
}
