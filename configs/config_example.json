{
  "_comment": "Complete example configuration with all available options",

  "model": {
    "in_channels": 3,
    "out_channels": 3,
    "num_timesteps": 1000,
    "base_channels": 64,
    "time_emb_dim": 256,
    "num_res_blocks": 2,
    "attention_resolutions": [16, 8],
    "channel_multiples": [1, 2, 4, 8]
  },

  "diffusion": {
    "_comment": "Flow matching formulation: z_t = t*x_0 + (1-t)*ε, v = x_0 - ε",
    "prediction_type": "epsilon",
    "loss_type": "epsilon",
    "time_sampler": "logit_normal",
    "time_sampler_params": {
      "mu": -0.8,
      "sigma": 0.8
    },
    "time_embedding_type": "continuous",
    "_options": {
      "prediction_type": ["epsilon", "x", "v"],
      "loss_type": ["epsilon", "x", "v"],
      "time_sampler": ["uniform", "logit_normal", "beta"],
      "time_embedding_type": ["continuous", "fourier", "discrete"]
    },
    "_notes": "All time values are continuous t ∈ [0,1]. Based on 'Back to Basics' paper."
  },

  "dataset": {
    "data_dir": "data",
    "scenes": [
      "97_RZ_3586578_Aug-24-09-59-20"
    ],
    "num_frames": 32,
    "image_size": [160, 210],
    "seed": 42
  },

  "dataloader": {
    "batch_size": 12,
    "shuffle": true,
    "num_workers": 4,
    "pin_memory": true,
    "drop_last": false,
    "persistent_workers": true
  },

  "optimizer": {
    "type": "AdamW",
    "lr": 1e-4,
    "betas": [0.9, 0.999],
    "weight_decay": 0.01,
    "eps": 1e-8
  },

  "training": {
    "epochs": 10,
    "gradient_accumulation_steps": 1,
    "max_grad_norm": 1.0,
    "mixed_precision": {
      "enabled": true,
      "dtype": "float16"
    },
    "checkpoint": {
      "save_every_n_epochs": 5,
      "save_dir": "checkpoints",
      "keep_last_n": 3
    },
    "logging": {
      "log_every_n_steps": 10,
      "log_gpu_memory": true
    }
  },

  "hardware": {
    "device": "cuda",
    "allow_tf32": true
  },

  "wandb": {
    "enabled": false,
    "project": "video-diffusion",
    "entity": null,
    "run_name": null,
    "tags": [],
    "notes": "",
    "watch_model": true,
    "sample_every_epoch": true,
    "num_sample_frames": 16,
    "sample_steps": 50
  },

  "performance_notes": {
    "description": "Example configuration demonstrating all available options",
    "backward_compatibility": "Old configs will still work - missing sections use defaults",
    "see_also": [
      "config_16gb.json - Optimized for 16GB VRAM",
      "config_15gb.json - Heavily optimized for 15GB VRAM"
    ]
  }
}
