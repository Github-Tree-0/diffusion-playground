{
  "_comment": "Toy experiment: D=64 embedding with x-prediction",

  "experiment_type": "toy",

  "model": {
    "input_dim": 64,
    "base_channels": 64,
    "time_emb_dim": 128,
    "num_res_blocks": 2,
    "channel_multiples": [1, 2, 4]
  },

  "diffusion": {
    "prediction_type": "x",
    "loss_type": "x",
    "time_sampler": "logit_normal",
    "time_sampler_params": {
      "mu": -0.8,
      "sigma": 0.8
    },
    "time_embedding_type": "continuous"
  },

  "dataset": {
    "data_dir": "toy_data",
    "embed_dim": 64,
    "seed": 42
  },

  "dataloader": {
    "batch_size": 256,
    "shuffle": true,
    "num_workers": 4,
    "pin_memory": true,
    "drop_last": true
  },

  "optimizer": {
    "type": "Adam",
    "lr": 1e-3,
    "betas": [0.9, 0.999],
    "weight_decay": 0.0
  },

  "training": {
    "epochs": 100,
    "gradient_accumulation_steps": 1,
    "max_grad_norm": 1.0,
    "mixed_precision": {
      "enabled": false
    },
    "checkpoint": {
      "save_every_n_epochs": 20,
      "save_dir": "checkpoints/toy_D64_x"
    },
    "logging": {
      "log_every_n_steps": 50
    }
  },

  "hardware": {
    "device": "cuda",
    "allow_tf32": true
  },

  "wandb": {
    "enabled": true,
    "project": "toy-diffusion",
    "run_name": "D64-x",
    "tags": ["toy", "D64", "x"]
  },

  "sampling": {
    "num_samples": 1000,
    "num_steps": 100,
    "visualize_every_n_epochs": 100
  }
}
